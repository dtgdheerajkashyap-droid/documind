# ---------------------------------------------------------------------------
# DocuMind configuration. Copy to `.env` (repo root, used by docker-compose)
# and/or `backend/.env` (used when running the backend locally).
# Every value has a sensible default; only GEMINI_API_KEY is needed for chat.
# ---------------------------------------------------------------------------

# --- LLM -------------------------------------------------------------------
# Which LLM backend to use: "gemini" (default) or "ollama".
LLM_PROVIDER=gemini
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# 0 disables "thinking" on Gemini 2.5 Flash (faster, cheaper). Leave empty to use the model default.
GEMINI_THINKING_BUDGET=0
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=60

# --- Database & storage ----------------------------------------------------
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=documind_chunks
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20

# --- Embeddings ------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# --- RAG pipeline ----------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
# Cosine similarity below which we refuse instead of calling the LLM.
RETRIEVAL_MIN_SCORE=0.3
# Number of previous user/assistant turns used to rewrite follow-up questions.
HISTORY_TURNS=3
QUERY_REWRITE_ENABLED=true

# --- API -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
CHAT_RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
# "json" for structured logs, "console" for human-readable logs.
LOG_FORMAT=json

# --- Frontend --------------------------------------------------------------
# URL the browser uses to reach the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- docker-compose Postgres -------------------------------------------------
POSTGRES_USER=documind
POSTGRES_PASSWORD=documind
POSTGRES_DB=documind
